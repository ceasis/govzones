{
  "name": "govzones",
  "private": true,
  "type": "module",
  "description": "GovZones \u2014 government offices, rated by the people. Cloudflare-native, zero-knowledge anonymous ballots.",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "typecheck": "wrangler types -c wrangler.jsonc && react-router typegen && tsc -b",
    "test": "vitest run",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "db:reset:local": "rm -rf .wrangler/state && node scripts/migrate-local.mjs",
    "zk:fetch": "node scripts/fetch-zk-artifacts.mjs",
    "keys:generate": "node scripts/generate-dev-keys.mjs",
    "setup": "npm run keys:generate && npm run zk:fetch && npm run db:migrate:local",
    "demo:ballots": "node scripts/seed-demo-ballots.mjs",
    "demo:tick": "node scripts/dev-tick.mjs",
    "e2e:ballot": "node scripts/e2e-ballot.mjs",
    "e2e:layout": "node scripts/check-layout.mjs",
    "deploy": "node scripts/deploy.mjs",
    "preview:deploy": "node scripts/deploy.mjs --env preview",
    "preview:destroy": "node scripts/preview-destroy.mjs",
    "e2e:browser": "node scripts/e2e-browser.mjs",
    "demo:clear": "node scripts/seed-demo-ballots.mjs --clear",
    "seed:build": "node scripts/build-directory-seed.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@semaphore-protocol/core": "4.14.5",
    "@semaphore-protocol/group": "4.14.5",
    "@semaphore-protocol/identity": "4.14.5",
    "@semaphore-protocol/proof": "4.14.5",
    "isbot": "^5.1.36",
    "poseidon-lite": "0.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
